{
  "name": "susika-queen-piano",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "verify": "npm run test && npm run build",
    "music:prepare": "node scripts/download-music.mjs",
    "music:verify": "node scripts/verify-two-fingers.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@soundtouchjs/audio-worklet": "2.1.1",
    "lucide-react": "1.54.0",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
